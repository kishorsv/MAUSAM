# ==============================================================================
# MAUSAM — SMART PERSONALIZED WEATHER INTELLIGENCE
# ENVIRONMENT CONFIGURATION SPECIFICATION (.env.example)
# ==============================================================================
#
# IMPORTANT SECURITY POLICY:
# 1. Server-Only Secrets: Keys without NEXT_PUBLIC_ prefix are ONLY accessible in Node.js runtime.
#    They are NEVER bundled into client-side JS bundles.
# 2. Public Browser Keys: ONLY keys prefixed with NEXT_PUBLIC_ are exposed to the browser.
# 3. Mode Toggle: Set NEXT_PUBLIC_DATA_MODE to 'live' for real APIs, or 'demo' for labeled sample data.
# 4. Key Rotation: Update keys here and in your hosting dashboard (Vercel/Cloudflare/AWS) seamlessly.
# ==============================================================================

# --- APPLICATION SETTINGS ---
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mode: 'live' (Real APIs + Real Cache) or 'demo' (Explicitly labeled demo dataset)
NEXT_PUBLIC_DATA_MODE=live

# --- AUTHENTICATION & SECURITY (SERVER-ONLY) ---
# Secret key used for JWT signing and session verification
# Obtain: Generate using `openssl rand -base64 32`
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security_12345
SESSION_MAX_AGE_DAYS=30

# --- DATABASE CONFIGURATION ---
# PostgreSQL connection string for production (Supabase, Neon, AWS RDS)
# Obtain: Supabase Dashboard -> Project Settings -> Database -> Connection URI
# Example: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=

# SQLite fallback path for instant local zero-dependency development
# Default: ./data/mausam.db (or data/mausam_storage.json)
SQLITE_DB_PATH=./data/mausam.db

# --- SUPABASE CONFIGURATION (OPTIONAL / PRODUCTION) ---
# Obtain: Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY: Used for administrative tasks and bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=

# --- WEATHER PROVIDER CONFIGURATION (SERVER-ONLY) ---
# Primary provider: 'open-meteo' (FREE, high-precision, no key required, global IMD/ECMWF/NOAA data)
# Alternative providers: 'weatherapi', 'openweathermap'
DEFAULT_WEATHER_PROVIDER=open-meteo
WEATHER_API_BASE_URL=https://api.open-meteo.com

# WeatherAPI.com (Optional, if using weatherapi provider)
# Obtain: https://www.weatherapi.com/signup.aspx
WEATHER_API_KEY=

# OpenWeatherMap (Optional)
# Obtain: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# Air Quality API Key (Optional if using WAQI or BreezoMeter)
# Obtain: https://aqicn.org/api/
AIR_QUALITY_API_KEY=

# --- AI ASSISTANT (MULTI-PROVIDER: GEMINI / OPENAI) (SERVER-ONLY) ---
# Active provider: 'gemini' | 'openai' | 'synthesizer'
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI / OpenAI-compatible (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Authentication Secret (Alias for JWT_SECRET)
AUTH_SECRET=


# --- MAPS & GEOCODING ---
# OpenStreetMap / Leaflet tile server is configured by default without requiring a paid key.
# Mapbox public token (Optional, if enhanced Mapbox tiles are desired)
# Obtain: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Google Maps Platform Browser API Key (Maps JavaScript API, Places API, Geocoding API, Routes)
# Obtain: https://console.cloud.google.com/google/maps-apis
# Setup: Apply HTTP referrer restrictions (http://localhost:3000/* and https://your-production-domain.com/*)
# Both NEXT_PUBLIC_GOOGLE_MAPS_API_KEY and NEXT_PUBLIC_GOOGLE_MAPS_KEY are supported.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- CACHE LAYER (SERVER-ONLY) ---
# Redis URI for distributed caching (Upstash, Redis Cloud)
# If omitted, Mausam automatically uses an in-memory/file LRU cache with TTL.
REDIS_URL=

# --- NOTIFICATIONS (FIREBASE CLOUD MESSAGING) ---
# Client-side configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Server-only private service account credentials for push notifications
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
